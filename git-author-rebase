#!/usr/bin/env sh
set -euo pipefail
export GIT_SEQUENCE_EDITOR='sed -i s/^pick/edit/g'
rm -frv ".git/rebase-merge"
AUTHOR="$1"

if test -z "$author"; then
    echo "usage: $0 'author name <author@email.com>'"
    exit 1
fi

git rebase -i --root

NUMBER_OF_REBASES="$(grep -c edit .git/rebase-merge/git-rebase-todo)"

for _ in $(seq "$NUMBER_OF_REBASES"); do
    git commit --amend --author="$AUTHOR" --no-edit
    git rebase --continue
done
